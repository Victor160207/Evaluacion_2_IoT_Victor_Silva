<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="HISTORIAL DE LECTURAS"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtResumenHistorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Guardado en SQLite (últimas 50)"
        android:textSize="14sp"
        android:layout_marginTop="6dp" />

    <ListView
        android:id="@+id/lstHistorial"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnBorrarHistorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BORRAR HISTORIAL" />

    <Button
        android:id="@+id/btnVolverHistorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VOLVER" />
</LinearLayout>
